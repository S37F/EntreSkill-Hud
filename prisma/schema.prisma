// EntreSkill Hub — PostgreSQL schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  MENTOR
  ADMIN
}

enum RoadmapStepType {
  VALIDATION
  TOOLS
  LEGAL
  COST
  MARKETING
  OTHER
}

enum ResourceType {
  VIDEO
  ARTICLE
  CHECKLIST
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorSessionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String?
  image         String?
  role          Role      @default(LEARNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userSkills    UserSkill[]
  userInterests UserInterest[]
  progress      UserProgress[]
  bookmarks     Bookmark[]

  mentorProfile MentorProfile?

  sessionsAsMentor  MentorSession[] @relation("SessionMentor")
  sessionsAsLearner MentorSession[] @relation("SessionLearner")

  questionsAsked   MentorQuestion[] @relation("QuestionAuthor")
  assignedQuestions MentorQuestion[] @relation("QuestionAssignedMentor")
  answersGiven     MentorAnswer[]   @relation("AnswerAuthor")

  resourcesAuthored LearningResource[]

  feedbacks Feedback[]
  reports   Report[] @relation("ReportReporter")
}

model Skill {
  id           String          @id @default(cuid())
  name         String          @unique
  category     String?
  userSkills   UserSkill[]
  ideaSkills   IdeaSkill[]
  mentorProfiles MentorProfile[] @relation("MentorExpertise")
}

model Interest {
  id           String         @id @default(cuid())
  name         String         @unique
  userInterests UserInterest[]
  ideaInterests IdeaInterest[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model BusinessIdea {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills    IdeaSkill[]
  interests IdeaInterest[]
  steps     RoadmapStep[]
  resources ResourceIdeaLink[]
  bookmarks Bookmark[]
  questions MentorQuestion[]
}

model IdeaSkill {
  ideaId  String
  skillId String
  idea    BusinessIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  skill   Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([ideaId, skillId])
}

model IdeaInterest {
  ideaId     String
  interestId String
  idea       BusinessIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  interest   Interest     @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([ideaId, interestId])
}

model RoadmapStep {
  id       String          @id @default(cuid())
  ideaId   String
  order    Int
  title    String
  body     String          @db.Text
  stepType RoadmapStepType @default(OTHER)

  idea     BusinessIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@index([ideaId, order])
}

model UserProgress {
  userId  String
  stepId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step    RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  doneAt  DateTime    @default(now())

  @@id([userId, stepId])
}

model Bookmark {
  userId String
  ideaId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea   BusinessIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@id([userId, ideaId])
}

model MentorProfile {
  userId      String   @id
  bio         String   @db.Text
  headline    String?
  verified    Boolean  @default(false)
  experience  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expertise Skill[] @relation("MentorExpertise")
}

model MentorSession {
  id        String              @id @default(cuid())
  mentorId  String
  learnerId String
  startAt   DateTime
  endAt     DateTime
  status    MentorSessionStatus @default(REQUESTED)
  notes     String?             @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  mentor  User @relation("SessionMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  learner User @relation("SessionLearner", fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([mentorId, startAt])
  @@index([learnerId])
}

model MentorQuestion {
  id        String         @id @default(cuid())
  authorId  String
  mentorId  String?
  ideaId    String?
  title     String
  body      String         @db.Text
  status    QuestionStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  author User         @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentor User?        @relation("QuestionAssignedMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  idea   BusinessIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  answers MentorAnswer[]

  @@index([mentorId])
  @@index([authorId])
}

model MentorAnswer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  question MentorQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User           @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model LearningResource {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  type        ResourceType
  url         String?
  fileKey     String?
  status      ResourceStatus @default(PENDING)
  authorId    String?
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ideas  ResourceIdeaLink[]
}

model ResourceIdeaLink {
  resourceId String
  ideaId     String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  idea       BusinessIdea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@id([resourceId, ideaId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String       @db.Text
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
}